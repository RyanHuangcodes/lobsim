# lobsim_calibrate on the hand-written km_example fixture (upgrade 3, C1): exit codes, the files it
# writes, and their labels. CALIBRATE, FIXTURE and OUT are passed by CMakeLists.txt.
if(NOT OUT)
  message(FATAL_ERROR "OUT is empty")
endif()
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
set(M ${FIXTURE}/TEST_2012-06-21_34200000_57600000_message_3.csv)
set(B ${FIXTURE}/TEST_2012-06-21_34200000_57600000_orderbook_3.csv)

function(expect_exit code)
  execute_process(COMMAND ${CALIBRATE} ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT rc EQUAL code)
    message(FATAL_ERROR "lobsim_calibrate ${ARGN}: exit ${rc}, expected ${code}\n${out}\n${err}")
  endif()
  set(last_out "${out}" PARENT_SCOPE)
  set(last_err "${err}" PARENT_SCOPE)
endfunction()

# Missing data: exit 3, naming the missing file.
expect_exit(3 estimate --messages ${OUT}/absent_message_3.csv --orderbook ${B} --out ${OUT}/x)
if(NOT last_err MATCHES "not found: .*absent_message_3.csv")
  message(FATAL_ERROR "the missing file is not named:\n${last_err}")
endif()
# Bad arguments: exit 1.
expect_exit(1)
expect_exit(1 frobnicate)
expect_exit(1 estimate --messages ${M})
expect_exit(1 estimate --messages ${M} --orderbook ${B} --tick-units 0)
expect_exit(1 estimate --messages ${M} --orderbook ${B} --from 34205 --to 34200)
expect_exit(1 estimate --messages ${M} --orderbook ${B} --source maybe)
expect_exit(1 estimate --messages ${M} --orderbook ${B} --from 1.5)
# Input that exists but cannot be estimated (a window without data): exit 1.
expect_exit(1 estimate --messages ${M} --orderbook ${B} --from 40000 --to 41000 --out ${OUT}/empty)
# A file name that is not a LOBSTER name: exit 1.
configure_file(${M} ${OUT}/messages.csv COPYONLY)
expect_exit(1 estimate --messages ${OUT}/messages.csv --orderbook ${B} --out ${OUT}/x)

# The real run: the JSON and the summary, labelled synthetic (README_SYNTHETIC.txt in the fixture).
expect_exit(0 estimate --messages ${M} --orderbook ${B} --from 34200 --to 34205 --out ${OUT}/run)
set(J ${OUT}/run/TEST_2012-06-21_34200-34205.json)
set(D ${OUT}/run/TEST_2012-06-21_34200-34205.md)
foreach(f ${J} ${D})
  if(NOT EXISTS ${f})
    message(FATAL_ERROR "not written: ${f}\n${last_out}")
  endif()
endforeach()
file(READ ${J} json)
string(JSON source GET "${json}" source)
string(JSON tick GET "${json}" tick_units)
string(JSON cancelled GET "${json}" lifetime "1-2" cancelled)
if(NOT source STREQUAL "synthetic" OR NOT tick EQUAL 100 OR NOT cancelled EQUAL 2)
  message(FATAL_ERROR "unexpected content: source ${source}, tick_units ${tick}, cancelled ${cancelled}")
endif()
file(READ ${D} md)
if(NOT md MATCHES "SYNTHETIC data, not market data")
  message(FATAL_ERROR "the summary does not say the data is synthetic")
endif()
# --source overrides the README.
expect_exit(0 estimate --messages ${M} --orderbook ${B} --from 34200 --to 34205 --source real --out ${OUT}/real)
file(READ ${OUT}/real/TEST_2012-06-21_34200-34205.json json)
string(JSON source GET "${json}" source)
if(NOT source STREQUAL "real")
  message(FATAL_ERROR "--source real gave ${source}")
endif()
